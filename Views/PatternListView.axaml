<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DesignPatternCatalog.ViewModels"
             xmlns:m="using:DesignPatternCatalog.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             x:Class="DesignPatternCatalog.Views.PatternListView"
             x:DataType="vm:PatternListViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,32,36,52" Spacing="28">

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBlock Text="The Catalog of Design Patterns" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           Foreground="#FFFFFF" 
                           VerticalAlignment="Center" />

                <Border Grid.Column="1" VerticalAlignment="Center"
                        Background="#101010" BorderBrush="#262626" BorderThickness="1" CornerRadius="8" Padding="4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                                  Foreground="#888888" Width="15" Height="15" Margin="0,0,8,0" />
                        <TextBox Text="{Binding SearchText}" 
                                 Watermark="Search patterns..." 
                                 Width="240" 
                                 BorderThickness="0" 
                                 Background="Transparent" 
                                 Foreground="White" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding SetCategoryCommand}" CommandParameter="All"
                        Background="#141414" BorderBrush="#262626" Foreground="#FFFFFF" CornerRadius="6" Padding="14,7">
                    <TextBlock Text="All" FontWeight="SemiBold" FontSize="13" />
                </Button>
                <Button Command="{Binding SetCategoryCommand}" CommandParameter="Creational"
                        Background="#141414" BorderBrush="#262626" Foreground="#FFFFFF" CornerRadius="6" Padding="14,7">
                    <TextBlock Text="Creational" FontWeight="Normal" FontSize="13" />
                </Button>
                <Button Command="{Binding SetCategoryCommand}" CommandParameter="Structural"
                        Background="#141414" BorderBrush="#262626" Foreground="#FFFFFF" CornerRadius="6" Padding="14,7">
                    <TextBlock Text="Structural" FontWeight="Normal" FontSize="13" />
                </Button>
                <Button Command="{Binding SetCategoryCommand}" CommandParameter="Behavioral"
                        Background="#141414" BorderBrush="#262626" Foreground="#FFFFFF" CornerRadius="6" Padding="14,7">
                    <TextBlock Text="Behavioral" FontWeight="Normal" FontSize="13" />
                </Button>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding FilteredPatterns}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="350" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:PatternItem">
                        <Border Margin="0,0,20,20" 
                                Background="#101010" 
                                BorderBrush="#222222" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="20"
                                Cursor="Hand">
                            <Border.Styles>
                                <Style Selector="Border:pointerover">
                                    <Setter Property="Background" Value="#171717" />
                                    <Setter Property="BorderBrush" Value="#FFFFFF" />
                                </Style>
                            </Border.Styles>

                            <Button Background="Transparent" 
                                    BorderThickness="0" 
                                    Padding="0" 
                                    HorizontalAlignment="Stretch" 
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Command="{Binding $parent[UserControl].((vm:PatternListViewModel)DataContext).SelectPatternCommand}" 
                                    CommandParameter="{Binding}">
                                <StackPanel Spacing="12">
                                    <Border Background="#050505" 
                                            BorderBrush="#222222" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Width="42" Height="42" 
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <PathIcon Data="{Binding IconGeometry}" 
                                                  Foreground="#FFFFFF" 
                                                  Width="20" Height="20" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="18" 
                                               FontWeight="Bold" 
                                               Foreground="#FFFFFF" />

                                    <TextBlock Text="{Binding DefinitionLine1}" 
                                               FontSize="12.5" 
                                               Foreground="#A3A3A3" 
                                               LineHeight="18" 
                                               MaxLines="2" 
                                               TextWrapping="Wrap" 
                                               TextTrimming="CharacterEllipsis" 
                                               Height="36" />

                                    <TextBlock Text="{Binding CodeFiles.Count, StringFormat='{}{0} C# files'}" 
                                               FontSize="11.5" 
                                               Foreground="#666666" 
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
