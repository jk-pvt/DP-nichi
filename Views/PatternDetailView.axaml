<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DesignPatternCatalog.ViewModels"
             xmlns:m="using:DesignPatternCatalog.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="1000"
             x:Class="DesignPatternCatalog.Views.PatternDetailView"
             x:DataType="vm:PatternDetailViewModel">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#0D0D0D" BorderBrush="#1F1F1F" BorderThickness="0,0,0,1" Padding="28,14">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0" 
                        Command="{Binding GoBackCommand}"
                        Background="#171717" 
                        BorderBrush="#292929"
                        Foreground="#FFFFFF" 
                        CornerRadius="6" 
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="←" FontWeight="Bold" />
                        <TextBlock Text="Back" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0" Spacing="8">
                    <TextBlock Text="Catalog" Foreground="#555555" FontSize="13" />
                    <TextBlock Text="/" Foreground="#333333" FontSize="13" />
                    <TextBlock Text="{Binding Pattern.CategoryName}" Foreground="#888888" FontSize="13" />
                    <TextBlock Text="/" Foreground="#333333" FontSize="13" />
                    <TextBlock Text="{Binding Pattern.Name}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,28,36,56" Spacing="24">

                <Border Background="#101010" 
                        BorderBrush="#222222" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="24,20">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" 
                                Background="#050505" 
                                BorderBrush="#262626" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Width="48" Height="48" 
                                Margin="0,0,20,0" 
                                VerticalAlignment="Top">
                            <PathIcon Data="{Binding Pattern.IconGeometry}" 
                                      Foreground="#FFFFFF" 
                                      Width="24" Height="24" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="10">
                            <TextBlock Text="{Binding Pattern.Name}" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="#FFFFFF" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Pattern.DefinitionLine1}" 
                                           FontSize="13.5" 
                                           FontWeight="SemiBold" 
                                           Foreground="#FFFFFF" 
                                           TextWrapping="Wrap" />
                                
                                <TextBlock Text="{Binding Pattern.DefinitionLine2}" 
                                           FontSize="13.5" 
                                           Foreground="#A3A3A3" 
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#101010" 
                        BorderBrush="#222222" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="24,20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding Pattern.RealLifeTitle}" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#FFFFFF" />

                        <TextBlock Text="{Binding Pattern.RealLifeAnalogy}" 
                                   FontSize="13" 
                                   Foreground="#CCCCCC" 
                                   LineHeight="20" 
                                   TextWrapping="Wrap" />

                        <Grid ColumnDefinitions="*,*">
                            <Border Grid.Column="0" Margin="0,0,8,0" 
                                    Background="#141414" 
                                    BorderBrush="#242424" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="14,12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Problem" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding Pattern.RealLifeProblem}" 
                                               FontSize="12" 
                                               Foreground="#999999" 
                                               LineHeight="18" 
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Margin="8,0,0,0" 
                                    Background="#141414" 
                                    BorderBrush="#242424" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="14,12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Solution" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding Pattern.RealLifeSolution}" 
                                               FontSize="12" 
                                               Foreground="#999999" 
                                               LineHeight="18" 
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>


                    </StackPanel>
                </Border>

                <Border Background="#101010" 
                        BorderBrush="#222222" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="24,20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{Binding Pattern.DemoTitle}" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#FFFFFF" />

                        <TextBlock Text="{Binding Pattern.DemoDescription}" 
                                   FontSize="12.5" 
                                   Foreground="#888888" />

                        <Border Background="#080808" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,*" Margin="0,0,0,2">
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0" IsVisible="{Binding HasInput1}" Spacing="4">
                                        <TextBlock Text="{Binding Pattern.InputLabel1}" FontSize="11.5" Foreground="#AAAAAA" />
                                        <TextBox Text="{Binding Input1}" Watermark="Enter value..." />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" IsVisible="{Binding HasInput2}" Spacing="4">
                                        <TextBlock Text="{Binding Pattern.InputLabel2}" FontSize="11.5" Foreground="#AAAAAA" />
                                        <TextBox Text="{Binding Input2}" Watermark="Enter value..." />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" Margin="0,0,0,2">
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0" IsVisible="{Binding HasOptionList1}" Spacing="4">
                                        <TextBlock Text="{Binding Pattern.OptionLabel1}" FontSize="11.5" Foreground="#AAAAAA" />
                                        <ComboBox ItemsSource="{Binding OptionList1}" 
                                                  SelectedItem="{Binding SelectedOption1}" 
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" IsVisible="{Binding HasOptionList2}" Spacing="4">
                                        <TextBlock Text="{Binding Pattern.OptionLabel2}" FontSize="11.5" Foreground="#AAAAAA" />
                                        <ComboBox ItemsSource="{Binding OptionList2}" 
                                                  SelectedItem="{Binding SelectedOption2}" 
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel IsVisible="{Binding HasToggles}" Spacing="6">
                                    <TextBlock Text="{Binding Pattern.ToggleLabel}" FontSize="11.5" Foreground="#AAAAAA" />
                                    <ItemsControl ItemsSource="{Binding ToggleOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ToggleOptionItem">
                                                <CheckBox Margin="0,0,16,6" 
                                                          IsChecked="{Binding IsSelected}" 
                                                          Content="{Binding Name}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Pattern.DemoActions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:DemoActionItem">
                                            <Button Margin="0,4,10,4" 
                                                    Classes="primary"
                                                    Padding="14,8"
                                                    Command="{Binding $parent[UserControl].((vm:PatternDetailViewModel)DataContext).ExecuteDemoActionCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="#000000" 
                                BorderBrush="#1C1C1C" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16">
                            <TextBlock Text="{Binding DemoOutput}" 
                                       FontFamily="Consolas, Menlo, Monospace, Courier New" 
                                       FontSize="12.5" 
                                       Foreground="#FFFFFF" 
                                       LineHeight="20" 
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="#101010" 
                        BorderBrush="#222222" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="24,20">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Source Code" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="#FFFFFF" 
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Copied" 
                                           IsVisible="{Binding IsCopiedToastVisible}" 
                                           Foreground="#FFFFFF" 
                                           FontSize="12" 
                                           VerticalAlignment="Center" />

                                <Button Command="{Binding CopyCurrentCodeCommand}" 
                                        Background="#171717" 
                                        BorderBrush="#292929" 
                                        CornerRadius="6" 
                                        Padding="10,6">
                                    <TextBlock Text="Copy" FontWeight="SemiBold" FontSize="12" Foreground="White" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding CodeFiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:CodeFileItem">
                                    <Button Margin="0,0,6,6" 
                                            Padding="10,6" 
                                            CornerRadius="6" 
                                            Command="{Binding $parent[UserControl].((vm:PatternDetailViewModel)DataContext).SelectCodeFileCommand}"
                                            CommandParameter="{Binding}"
                                            Background="{Binding $parent[UserControl].((vm:PatternDetailViewModel)DataContext).SelectedCodeFile, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={Binding}, FallbackValue='#141414'}">
                                        <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="White" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding SelectedCodeFile.Description}" 
                                   FontSize="12" 
                                   Foreground="#888888" 
                                   TextWrapping="Wrap" />

                        <Border Background="#000000" 
                                BorderBrush="#1C1C1C" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16">
                            <TextBox Text="{Binding SelectedCodeFile.Code}" 
                                     IsReadOnly="True" 
                                     FontFamily="Consolas, Menlo, Monospace, Courier New" 
                                     FontSize="12.5" 
                                     Foreground="#D4D4D4" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     AcceptsReturn="True" 
                                     TextWrapping="NoWrap" />
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
