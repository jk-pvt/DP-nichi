<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DesignPatternCatalog.App"
             xmlns:local="using:DesignPatternCatalog"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#171717" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#262626" />
            <Setter Property="BorderBrush" Value="#666666" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#E5E5E5" />
            <Setter Property="BorderBrush" Value="#E5E5E5" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0D0D0D" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="SelectionBrush" Value="#404040" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="Background" Value="#121212" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#141414" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#E5E5E5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="True" />
        </Style>
    </Application.Styles>
</Application>